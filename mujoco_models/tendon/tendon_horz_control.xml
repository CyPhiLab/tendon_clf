<mujoco model="tendon_horz_control">
    <compiler angle="radian"/>
    <option gravity="0 0 -9.81" integrator="implicitfast" timestep="0.005"/>

    <default>
        <joint type="hinge" axis="0 1 0" limited="true" range="-1.57 1.57" damping="0.01"/>
        <geom type="capsule" size="0.005 0.03" rgba="1 1 1 1" mass="0.01"/>

    </default>

    <!-- <asset>
        <texture type="skybox" builtin="flat" rgb1="1 1 1" rgb2="0 0 0" width="512" height="3072"/>
    </asset> -->

        <!-- ================= BACKGROUND ================= -->
    <asset>
        <texture type="skybox" builtin="flat" rgb1="1 1 1" rgb2="1 1 1"
                 width="512" height="512"/>
        <texture type="2d" name="groundplane" builtin="flat"
                 rgb1="0.9 0.9 0.9" rgb2="0.9 0.9 0.9"
                 width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true"
                  texrepeat="5 5" reflectance="0.1"/>
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane"/>
        <camera name="ortho_side"
            mode="fixed"
            pos="0.05 -1 0.15"
            xyaxes="1 0 0  0 0 1"
            fovy="0.33"/>
        <body name="link1" pos="0 0 0.15">
            <joint name="joint1" />
            <geom fromto="0 0 0 0.06 0 0" size="0.008" rgba="0.8 0.7 0.5 1"/>
            <body name="link2" pos="0.06 0 0">
                <joint name="joint2"/>
                <geom fromto="0 0 0 0.06 0 0" size="0.008" rgba="0.8 0.7 0.5 1"/>
                <body name="link3" pos="0.06 0 0">
                    <joint name="joint3"/>
                    <geom fromto="0 0 0 0.06 0 0" size="0.008" rgba="0.8 0.7 0.5 1"/>
                    <body name="link4" pos="0.06 0 0">
                        <joint name="joint4"/>
                        <geom fromto="0 0 0 0.06 0 0" size="0.008" rgba="0.8 0.7 0.5 1"/>
                        <body name="attachment" pos="0.06 0.0 0.0">
                              <site name="ee" rgba="1 0 0 1" size="0.001" group="1"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <worldbody>
        <body name="target" pos="0.1 0.0 -0.15" quat="0 1 0 0" mocap="true">
            <geom name="target_vis" type="sphere" size="0.01"
                  contype="0" conaffinity="0" rgba="1 0.2 0.2 0.9"/>
        </body>
    </worldbody>

        <visual>
        <rgba haze="1 1 1 1"/>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <global azimuth="140" elevation="-20" offwidth="1920" offheight="1080"/>
    </visual>

    <!-- Tendon-based antagonistic actuation -->
    <tendon>
        <!-- Tendon pair A -->
        <fixed name="tendon_a_flex">
            <joint joint="joint1" coef="1"/>
            <joint joint="joint2" coef="1"/>
        </fixed>
        <fixed name="tendon_a_ext">
            <joint joint="joint1" coef="-1"/>
            <joint joint="joint2" coef="-1"/>
        </fixed>

        <!-- Tendon pair B -->
        <fixed name="tendon_b_flex">
            <joint joint="joint3" coef="1"/>
            <joint joint="joint4" coef="1"/>
        </fixed>
        <fixed name="tendon_b_ext">
            <joint joint="joint3" coef="-1"/>
            <joint joint="joint4" coef="-1"/>
        </fixed>
    </tendon>


    <!-- Actuators for tendons -->
    <actuator>
        <motor tendon="tendon_a_flex" ctrlrange="0 1" gear="0.1"/>
        <motor tendon="tendon_a_ext" ctrlrange="0 1" gear="0.1"/>
        <motor tendon="tendon_b_flex" ctrlrange="0 1" gear="0.1"/>
        <motor tendon="tendon_b_ext" ctrlrange="0 1" gear="0.1"/>
    </actuator>
</mujoco>
