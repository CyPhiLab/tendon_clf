<mujoco model="scene">
    <!-- compiler must come after the include -->
    <include file="../../external/spirob_mujoco/models/spirob.xml" />
    <compiler meshdir="../../external/spirob_mujoco/models/assets" />
    <!-- adjacent segments are stopped by joint limits, not collision -->
    <option><flag filterparent="enable"/></option>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="1 1 1 1" />
        <global azimuth="160" elevation="-20" offwidth="1920" offheight="1080" />
    </visual>
 
    <asset>
        <texture type="skybox" builtin="flat" rgb1="1 1 1" rgb2="1 1 1" width="512"
            height="512" />
        <texture type="2d" name="groundplane" builtin="flat" rgb1="0.9 0.9 0.9"
            rgb2="0.9 0.9 0.9" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.1" />
    </asset>
 
    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />
 
        <!-- target -->
        <body name="target" mocap="true" pos="0.0 0.25 0.25">
            <geom name="target_vis"
                  type="sphere"
                  size="0.02"
                  rgba="1 0.2 0.2 0.9"
                  contype="0"
                  conaffinity="0"/>
        </body>
 
    </worldbody>

    <keyframe>
        <key name="init" qpos="
            -0.000146 -0.392 2.12e-05 -0.179 0.000107 -0.0522 0.00015 0.0243 0.000164 0.0696 0.00016 0.0932 0.000142 0.1 0.000116 0.0955 8.71e-05 0.082 5.92e-05 0.0628 3.06e-05 0.0402 1.29e-05 0.0167 -3.35e-05 0.00185 -3.22e-05 -0.0011 -2.21e-05 -0.000766 -1.71e-05 -0.000355 -1.31e-05 -7.15e-05 -9.32e-06 5.7e-05 -6.01e-06 9.01e-05 -3.5e-06 4.18e-05 -1.84e-06 -2.06e-05 -8.62e-07 -2.74e-05 -2.97e-07 -1.51e-05 3.46e-09 -2.7e-06
        "/>
    </keyframe>

</mujoco>